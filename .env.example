# =============================================================================
#  Trading-Bot-Windows-Edition — environment configuration
#  Copy to ".env" and fill in. NEVER commit the real .env (see .gitignore).
# =============================================================================

# --- Safety -----------------------------------------------------------------
# paper  = simulate everything, never send live orders (DEFAULT, recommended)
# live   = send real orders to Kalshi. Only after extensive paper validation.
TRADING_MODE=paper

# --- Kalshi v2 API (RSA key auth) -------------------------------------------
# Create an API key in the Kalshi web UI -> Account -> API Keys.
# It gives you a Key ID and downloads a private key (PEM) once.
KALSHI_API_KEY_ID=your-kalshi-key-id-uuid
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# Production:  https://api.elections.kalshi.com
# Demo/sandbox: https://demo-api.kalshi.co
KALSHI_API_HOST=https://api.elections.kalshi.com

# --- Gemini (Captain oversight layer) ---------------------------------------
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.0-flash

# --- Forecasting (TimesFM) --------------------------------------------------
# cpu | gpu     (gpu requires a CUDA-enabled PyTorch build)
TIMESFM_BACKEND=cpu
TIMESFM_REPO_ID=google/timesfm-2.0-500m-pytorch

# --- Spot price feed --------------------------------------------------------
# coinbase (US-friendly, DEFAULT) | binance
SPOT_PROVIDER=coinbase

# --- Markets ----------------------------------------------------------------
# Comma-separated Kalshi series tickers to trade.
MARKET_SERIES=KXBTC15M,KXETH15M

# --- Risk / sizing ----------------------------------------------------------
PORTFOLIO_VALUE_USD=10000        # used if the live balance cannot be fetched
FRACTIONAL_KELLY=0.25            # base fractional-Kelly safety scalar
DAILY_STOP_LOSS_PCT=0.05         # 5% daily loss -> halt for the day
MAX_POSITION_PCT=0.10            # 10% of portfolio per position cap
BASE_EDGE_BUFFER=0.02            # added on top of spread before crossing

# --- Timing gate (minutes before a market expires) --------------------------
# The bot ONLY evaluates a market when it is between these two values from
# expiry. Default 6-9 min is conservative and means trades are intermittent.
# Widen it (e.g. 2 and 13) to evaluate markets far more often / trade sooner.
TRADE_WINDOW_MIN=6
TRADE_WINDOW_MAX=9

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=trading.log
